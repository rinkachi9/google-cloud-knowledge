{
  "version": 1,
  "project": {
    "name": "Google Cloud Knowledge",
    "description": "A personal knowledge base about Google Cloud: global infrastructure, products, architecture, security, operations and DevOps, organized by the Google Cloud product categories.",
    "language": "en"
  },
  "entryPoints": [
    {
      "path": "foundations"
    },
    {
      "path": "compute"
    },
    {
      "path": "containers-and-kubernetes"
    },
    {
      "path": "storage-and-databases"
    },
    {
      "path": "networking"
    },
    {
      "path": "security-and-identity"
    },
    {
      "path": "data-analytics"
    },
    {
      "path": "ai-and-machine-learning"
    },
    {
      "path": "developer-and-devops-tools"
    },
    {
      "path": "operations"
    },
    {
      "path": "integration-and-apis"
    },
    {
      "path": "hybrid-and-multicloud"
    },
    {
      "path": "management-and-governance"
    },
    {
      "path": "case-studies"
    }
  ],
  "ignore": [
    "_assets"
  ],
  "toc": {
    "file": "ToC.md",
    "check": true,
    "descriptions": {
      ".gitignore": "Files excluded from version control.",
      "librarian-os.json": "Configuration for Librarian OS: project name, entry points and rules."
    }
  },
  "rules": {
    "requireSidecars": true,
    "noLongDashes": true
  }
}
